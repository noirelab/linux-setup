{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "height": 26,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/window"
    ],
    "modules-center": [
        "custom/weather",
        "clock",
        "custom/system-update"
    ],
    "modules-right": [
        "tray",
        "custom/cpu",
        "custom/gpu",
        "bluetooth",
        "network",
        "pulseaudio",
        "custom/monitor",
        "custom/power"
    ],

    // ----------------------------------------------------------
    // custom/launcher
    // ----------------------------------------------------------
    "custom/launcher": {
        "format": "  󰣇  ",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    // ----------------------------------------------------------
    // hyprland/workspaces
    // ----------------------------------------------------------
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "○",
            "empty": "○"
        },
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": []
        }
    },

    // ----------------------------------------------------------
    // custom/window (active window title)
    // ----------------------------------------------------------
    "custom/window": {
        "exec": "~/.config/waybar/scripts/window.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 1,
        "max-length": 60
    },

    // ----------------------------------------------------------
    // custom/weather
    // ----------------------------------------------------------
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 900,
        "tooltip": true
    },

    // ----------------------------------------------------------
    // clock
    // ----------------------------------------------------------
    "clock": {
        "format": "{:%b %d  %I:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // ----------------------------------------------------------
    // custom/system-update
    // ----------------------------------------------------------
    "custom/system-update": {
        "exec": "~/.config/waybar/scripts/system-update.sh",
        "return-type": "json",
        "interval": 3600,
        "on-click": "kitty -e sudo pacman -Syu",
        "tooltip": true
    },

    // ----------------------------------------------------------
    // tray
    // ----------------------------------------------------------
    "tray": {
        "icon-size": 16,
        "spacing": 4
    },

    // ----------------------------------------------------------
    // custom/cpu
    // ----------------------------------------------------------
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "kitty -e btop"
    },

    // ----------------------------------------------------------
    // custom/gpu
    // ----------------------------------------------------------
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "kitty -e nvtop"
    },

    // ----------------------------------------------------------
    // bluetooth
    // ----------------------------------------------------------
    "bluetooth": {
        "format": "{icon}",
        "format-icons": {
            "on": "󰂯",
            "off": "󰂲",
            "connected": "󰂱",
            "discoverable": "󰂰"
        },
        "on-click": "blueman-manager",
        "tooltip": true
    },

    // ----------------------------------------------------------
    // network
    // ----------------------------------------------------------
    "network": {
        "format": "{icon}",
        "format-icons": {
            "wifi": "󰖩",
            "ethernet": "󰈀",
            "disconnected": "󰖪"
        },
        "on-click": "kitty -e nmtui",
        "tooltip": true
    },

    // ----------------------------------------------------------
    // pulseaudio
    // ----------------------------------------------------------
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip": true
    },

    // ----------------------------------------------------------
    // custom/monitor
    // ----------------------------------------------------------
    "custom/monitor": {
        "format": "󰍹",
        "on-click": "kitty -e wdisplays",
        "tooltip": false
    },

    // ----------------------------------------------------------
    // custom/power
    // ----------------------------------------------------------
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -b 2",
        "tooltip": false
    }
}
