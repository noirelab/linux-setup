{
    "editor.fontFamily": "'CaskaydiaMono Nerd Font', 'Droid Sans Mono', 'monospace'",
    "editor.fontLigatures": true, // Optional: Set to true if you want ligatures
    "RainbowBrackets.depreciation-notice": false,
    "lldb.suppressUpdateNotifications": true,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": true
    },
    "git.openRepositoryInParentFolders": "never",
    "workbench.layoutControl.enabled": false,
    "githubPullRequests.createOnPublishBranch": "never",
    "redhat.telemetry.enabled": false,
    "workbench.productIconTheme": "material-product-icons",
    "workbench.iconTheme": "vscode-icons",
    "python.analysis.diagnosticSeverityOverrides": {},
    "workbench.sideBar.location": "right",

    "editor.copyWithSyntaxHighlighting": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.emptySelectionClipboard": false,
    "window.newWindowDimensions": "inherit",
    "editor.multiCursorModifier": "ctrlCmd",
    "files.trimTrailingWhitespace": true,
    "diffEditor.renderSideBySide": false,
    "editor.snippetSuggestions": "top",
    "editor.detectIndentation": false,
    "window.nativeFullScreen": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "workbench.editor.showTabs": "single",
    "editor.lineNumbers": "on",
    "editor.guides.indentation": false,

    // Silence the Noise
    "scm.diffDecorations": "none",
    "editor.hover.delay": 750,
    "editor.hover.enabled": "on",
    "editor.matchBrackets": "never",
    "workbench.tips.enabled": false,
    "editor.colorDecorators": false,
    "git.decorations.enabled": false,
    "workbench.startupEditor": "none",
    "editor.lightbulb.enabled": "off",
    "editor.selectionHighlight": false,
    "editor.overviewRulerBorder": false,
    "editor.renderLineHighlight": "none",
    "editor.occurrencesHighlight": "off",
    "problems.decorations.enabled": false,
    "editor.renderControlCharacters": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",

    // custom styles
    "vscode_custom_css.imports": [
        "file://c:/Users/kaiqu/custom-vs-code/custom-vscode.css",
    ],
    "editor.wordWrap": "off",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
        "*.dart": "${capture}.g.dart",
        "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
        "*.csproj": "${capture}.csproj.user",
        "*.json": "${capture}.Development.json",
        "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
        "*.razor": "${capture}.razor.cs,${capture}.razor.css",
        "*.resx": "${capture}.Designer.cs",
        "*.xaml": "${capture}.xaml.cs",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "workbench.editor.enablePreview": false,
    "git.confirmSync": false,
    "git.autofetch": true,
    "editor.fontSize": 18,
    "git.enableSmartCommit": true,
    "security.workspace.trust.untrustedFiles": "open",
    "vsicons.dontShowNewVersionMessage": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "editor.inlineSuggest.edits.allowCodeShifting": "never",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.colorTheme": "Sublime MavensMate Monokai Dimmed",
    "jupyter.askForKernelRestart": false,
    "chat.tools.terminal.autoApprove": {
        "/home/noirelab/miniconda3/envs/kivy/bin/buildozer": true,
        "flutter": true
    },
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": true
    },
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "chat.agent.maxRequests": 50,
    "liveServer.settings.donotShowInfoMsg": true,
    "chat.mcp.serverSampling": {},
    "workbench.editor.empty.hint": "hidden",
    "terminal.integrated.inheritEnv": false,
    "mssql.connectionGroups": [
        {
            "name": "ROOT",
            "id": "ROOT"
        }
    ],
    "mssql.autoDisableNonTSqlLanguageService": false,
    "task.allowAutomaticTasks": "on",
    "geminicodeassist.project": "solar-rigging-k3hw8",
    "google.cloud.project": "rectaz-whatsapp-integration",
    "claudeCode.preferredLocation": "panel",
    "explorer.confirmDragAndDrop": false,
}
